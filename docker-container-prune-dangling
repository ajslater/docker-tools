#!/bin/bash
# Remove stopped containers with dangling (untagged) ancestor images
#
# Replaces a simpler but less dockery one liner that might bug with very simple image tags:
# docker ps -a | tail -n +2 | awk '$2 ~ "^[0-9a-f]+$" {print $1}' | xargs docker rm --volumes
#

FILTERS=()
while IFS="" read -r image_id; do
    FILTERS+=("--filter=ancestor=$image_id")
done < <(docker image ls --format '{{.ID}}' --filter=dangling=true)
if [ ${#FILTERS[@]} -eq 0 ]; then
    echo "No dangling images. So no containers with dangling ancestor images."
    exit 0
fi

# Don't remove running containers: list only stopped ones.
# Docker ORs filters that share a key and ANDs different keys.
DANGLING_CONTAINERS=()
while IFS="" read -r container_id; do
    DANGLING_CONTAINERS+=("$container_id")
done < <(docker container ls --all --format '{{.ID}}' \
    --filter=status=created --filter=status=exited --filter=status=dead \
    "${FILTERS[@]}")
if [ ${#DANGLING_CONTAINERS[@]} -eq 0 ]; then
    echo "No stopped containers with dangling ancestor images."
    exit 0
fi

echo "Removing stopped containers with dangling ancestor images"
docker container rm --volumes "${DANGLING_CONTAINERS[@]}"
