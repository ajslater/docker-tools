#!/usr/bin/env bash
# Shut down docker desktop
set -exuo pipefail
docker_running() {
  [ "$(osascript -e 'application "Docker" is running')" = "true" ]
}
if docker_running; then
  if [ "${1-}" != "-f" ]; then
    CONTAINERS=()
    while IFS="" read -r line; do CONTAINERS+=("$line"); done < <(docker ps -q)
    if [ ${#CONTAINERS[@]} -gt 0 ]; then
      echo "Stopping all containers..."
      docker stop "${CONTAINERS[@]}"
    fi
  fi
  echo "Quitting docker..."
  osascript -e 'quit app "Docker"'
  TRIES=0
  while docker_running && [ "$TRIES" -lt 10 ]; do
    echo "Docker is still running :("
    sleep 1
    TRIES=$((TRIES + 1))
  done
  if docker_running; then
    pkill docker
  fi
fi
